      "skills": [
        "mobile_reader_assembly"
      ],
      "write_scope": [
        "app/**",
        "public/**"
      ],
      "may": [
        "implement navigation/motion/accessibility",
        "bind approved assets"
      ],
      "may_not": [
        "change editorial sequence without approval",
        "replace missing production asset with misleading mock media"
      ],
      "escalate_when": [
        "a higher-authority source conflicts",
        "required evidence is missing",
        "requested work exceeds write scope or decision authority"
      ]
    },
    {
      "id": "source_registrar",
      "group": "publication",
      "job": "Maintain inspectable source, rights and claim traceability",
      "skills": [
        "source_trace"
      ],
      "write_scope": [
        "content/{edition_id}/sources/**"
      ],
      "may": [
        "assign/register provenance",
        "flag orphan claims/assets"
      ],
      "may_not": [
        "decide story aesthetics",
        "weaken rights/use boundaries"
      ],
      "escalate_when": [
        "a higher-authority source conflicts",
        "required evidence is missing",
        "requested work exceeds write scope or decision authority"
      ]
    },
    {
      "id": "signal_extractor",
      "group": "publication",
      "job": "Build a structured Signal Library from the locked edition and source register",
      "skills": [
        "signal_extraction",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "extract source-grounded signals",
        "classify factual/analytical/fictional material",
        "attach registered evidence references",
        "add routing metadata"
      ],
      "may_not": [
        "invent new factual claims",
        "treat fiction as evidence",
        "publish externally",
        "change the approved reader"
      ],
      "escalate_when": [
        "a factual signal has no registered evidence",
        "classification is ambiguous",
        "a signal would require a stronger causal claim than the edition supports"
      ]
    },
    {
      "id": "signal_priority_decider",
      "group": "publication",
      "job": "Make a bounded, inspectable ADVANCE/HOLD/STOP decision for each eligible Signal Library item",
      "skills": [
        "signal_priority_decision",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "apply hard eligibility checks",
        "choose ADVANCE HOLD or STOP",
        "record decision reasons and preserved evidence",
        "hold consequential signals for human review"
      ],
      "may_not": [
        "publish externally",
        "use predicted engagement as editorial importance",
        "override evidence or fact/fiction boundaries",
        "change the approved reader"
      ],
      "escalate_when": [
        "eligibility fails ambiguously",
        "cultural or factual sensitivity requires human judgment",
        "a decision would require evidence not present in the Signal Library"
      ]
    },
    {
      "id": "relevance_router",
      "group": "publication",
      "job": "Route ADVANCE signals to audiences with a legitimate reason to care before destination discovery",
      "skills": [
        "relevance_routing",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "route only ADVANCE signals",
        "record audience and relevance reason",
        "preserve geography evidence and classification",
        "hold or reject weak relevance"
      ],
      "may_not": [
        "select platforms or destinations",
        "publish externally",
        "invent audience evidence",
        "turn commercial relevance into the default route"
      ],
      "escalate_when": [
        "relevance requires evidence not present upstream",
        "fiction boundary could be obscured",
        "a culturally sensitive audience route needs human judgment"
      ]
    },
    {
      "id": "destination_discovery_worker",
      "group": "publication",
      "job": "Discover real current destinations for approved relevance routes and record evidence of fit and access constraints",
      "skills": [
        "destination_discovery",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "search current external landscape",
        "verify destination existence",
        "record audience fit evidence",
        "record access and permission constraints"
      ],
      "may_not": [
        "publish or contact destinations",
        "assume permission from relevance",
        "generate distribution variants",
        "change the approved reader"
      ],
      "escalate_when": [
        "destination participation rules are unclear",
        "outreach would represent Atlas publicly",
        "community or institutional participation requires permission"
      ]
    },
    {
      "id": "route_decider",
      "group": "publication",
      "job": "Make bounded PURSUE/HOLD/REJECT decisions for evidenced signal-audience-destination opportunities",
      "skills": [
        "route_decision",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "compare signal audience and destination fit",
        "prefer fewer stronger routes",
        "record permission actionability",
        "reject poor or duplicative opportunities"
      ],
      "may_not": [
        "generate variants",
        "contact or submit to destinations",
        "publish externally",
        "treat reach as editorial value"
      ],
      "escalate_when": [
        "a PURSUE route requires outreach submission or community participation",
        "permission state is ambiguous",
        "route would require stronger evidence than the edition contains"
      ]
    },
    {
      "id": "distribution_editor",
      "group": "publication",
      "job": "Create destination-aware internal candidate expressions only for approved PURSUE routes",
      "skills": [
        "distribution_derivation",
        "boundary_audit",
        "variant_factory"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**",
        "public/distribution/**"
      ],
      "may": [
        "adapt format/length/hooks",
        "link back to source edition",
        "create internal candidate expressions for PURSUE routes",
        "adapt angle and depth to evidenced audience and destination context"
      ],
      "may_not": [
        "invent platform-specific facts",
        "erase fiction labels",
        "imitate a destination's editorial voice",
        "imply destination endorsement or access",
        "contact submit schedule or publish externally"
      ],
      "creative_intensity": {
        "min": 0,
        "max": 4,
        "default": 3
      },
      "escalate_when": [
        "a higher-authority source conflicts",
        "required evidence is missing",
        "requested work exceeds write scope or decision authority"
      ]
    },
    {
      "id": "format_worker",
      "group": "publication",
      "job": "Choose and specify the appropriate production form for each approved internal candidate",
      "skills": [
        "format_selection",
        "boundary_audit",
        "source_trace"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "choose text visual data or media form from route purpose",
        "specify length structure labels and evidence requirements",
        "flag localisation as a separate verification need"
      ],
      "may_not": [
        "make every candidate into every format",
        "release translations",
        "contact destinations",
        "submit schedule or publish externally"
      ],
      "escalate_when": [
        "format could obscure fact/fiction classification",
        "localisation needs cultural or language verification",
        "production would require new unsupported evidence"
      ]
    },
    {
      "id": "destination_adapter_worker",
      "group": "publication",
      "job": "Adapt approved format specifications to verified destination mechanics while preserving permission boundaries",
      "skills": [
        "destination_adaptation",
        "source_trace",
        "boundary_audit"
      ],
      "write_scope": [
        "content/{edition_id}/distribution/**"
      ],
      "may": [
        "verify current destination mechanics",
        "record deadlines and contribution modes",
        "shape an internal package to verified requirements",
        "hold routes where access remains unclear"
      ],
      "may_not": [
        "invent submission mechanics",
        "infer permission from topical fit",
        "contact destinations",
        "submit schedule or publish externally"
      ],
      "escalate_when": [
        "destination rules are ambiguous",
        "outreach or institutional submission is required",
        "destination mechanics have changed since discovery"
      ]
    },
    {
