{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlasoquence Evidence Graph",
  "type": "object",
  "required": ["schema_version","edition_id","world_change","nodes","edges"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "edition_id":{"type":"string","minLength":1},
    "world_change":{
      "type":"object",
      "required":["statement","evidence_refs"],
      "properties":{
        "statement":{"type":"string","minLength":1},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}}
      }
    },
    "nodes":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","kind","statement","state","provenance"],
        "properties":{
          "id":{"type":"string"},
          "kind":{"enum":["world_change","claim","geography","actor","system","constraint","consequence","unknown"]},
          "statement":{"type":"string"},
          "state":{"enum":["KNOWN","UNCERTAIN","CONTESTED","UNKNOWN","UNAVAILABLE","FICTION_EDITORIAL"]},
          "provenance":{"type":"array","items":{"type":"object","required":["source_id","locator"],"properties":{"source_id":{"type":"string"},"locator":{"type":"string"},"url":{"type":"string"},"retrieved_at":{"type":"string"}}}},
          "limitations":{"type":"array","items":{"type":"string"}},
          "geography":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "edges":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["from","to","relation","state","evidence_refs"],
        "properties":{
          "from":{"type":"string"},"to":{"type":"string"},"relation":{"type":"string"},
          "state":{"enum":["KNOWN","UNCERTAIN","CONTESTED","UNKNOWN","UNAVAILABLE"]},
          "evidence_refs":{"type":"array","items":{"type":"string"}},
          "causal_claim":{"type":"boolean"},
          "boundary":{"type":"string"}
        }
      }
    }
  }
}